{
  "name": "zedzen-media-converter",
  "productName": "ZED-ZEN Media Converter",
  "version": "1.0.0",
  "description": "Professional media conversion tool by ZED-ZEN",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "generate-icon": "node scripts/generate-icon.js",
    "generate-assets": "node scripts/generate-installer-assets.js",
    "make:nsis": "npm run generate-icon && npm run generate-assets && electron-forge package && electron-builder --config electron-builder.config.js --win nsis --prepackaged \"out/ZED-ZEN Media Converter-win32-x64\"",
    "build:installer": "electron-builder --config electron-builder.config.js --win nsis --prepackaged \"out/ZED-ZEN Media Converter-win32-x64\"",
    "make:mac": "npm run generate-icon && npm run generate-assets && node scripts/dist.js",
    "make:linux": "npm run generate-icon && npm run generate-assets && node scripts/dist.js",
    "dist": "npm run generate-icon && npm run generate-assets && node scripts/dist.js",
    "publish": "electron-forge publish",
    "lint": "eslint ."
  },
  "keywords": [
    "media",
    "converter",
    "zedzen",
    "image",
    "video"
  ],
  "author": "ZED-ZEN / Fortitudo Vincit SRL",
  "license": "MIT",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "docx": "^9.5.1",
    "fluent-ffmpeg": "^2.1.3",
    "mammoth": "^1.11.0",
    "officegen": "^0.6.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "electron": "44.1.1",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "webpack-dev-server": "$webpack-dev-server",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.1"
  }
}
